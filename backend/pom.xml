<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent of the two backend services. Build both from this folder:
        mvnw.cmd package -DskipTests          (Windows)
        ./mvnw package -DskipTests            (macOS / Linux)
      or one of them: mvnw.cmd -pl status-service -am spring-boot:run
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example.devicestatus</groupId>
    <artifactId>device-status-backend</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Device Status Management System - backend</name>

    <modules>
        <module>ingest-api</module>
        <module>status-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- Docker Engine 29+ rejects the old default API version Testcontainers asks for. -->
                            <api.version>1.44</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
